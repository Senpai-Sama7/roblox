--[[
    GenerateLevelData — Studio utility.
    Run this in Roblox Studio to auto-generate LevelData.luau
    content from tagged parts in the current place.
    
    Steps:
    1. Add this script to ServerScriptService
    2. Ensure your place has parts tagged with:
       - "Checkpoint" (with Order attribute)
       - "Coin"
       - "FinishLine"
    3. Run the game in Studio
    4. Copy the output to src/ReplicatedStorage/LevelData.luau
]]

local CollectionService = game:GetService("CollectionService")
local workspace = game:GetService("Workspace")

local function generateLevelData()
    local checkpoints = {}
    for _, cp in ipairs(CollectionService:GetTagged("Checkpoint")) do
        if cp:IsA("BasePart") then
            local order = cp:GetAttribute("Order")
            if type(order) ~= "number" then order = 0 end
            table.insert(checkpoints, {
                position = string.format("Vector3.new(%.3f, %.3f, %.3f)", cp.Position.X, cp.Position.Y, cp.Position.Z),
                order = order,
            })
        end
    end

    local coins = {}
    for _, coin in ipairs(CollectionService:GetTagged("Coin")) do
        if coin:IsA("BasePart") then
            table.insert(coins, string.format("Vector3.new(%.3f, %.3f, %.3f)", coin.Position.X, coin.Position.Y, coin.Position.Z))
        end
    end

    local finishLine = nil
    for _, fl in ipairs(CollectionService:GetTagged("FinishLine")) do
        if fl:IsA("BasePart") then
            finishLine = string.format("Vector3.new(%.3f, %.3f, %.3f)", fl.Position.X, fl.Position.Y, fl.Position.Z)
            break
        end
    end

    table.sort(checkpoints, function(a, b) return a.order < b.order end)

    local output = {}
    table.insert(output, "-- Generated by GenerateLevelData on " .. os.date("%Y-%m-%d %H:%M:%S"))
    table.insert(output, "-- Checkpoints: " .. tostring(#checkpoints) .. ", Coins: " .. tostring(#coins) .. ", FinishLine: " .. tostring(finishLine ~= nil))
    table.insert(output, "")
    table.insert(output, "local LevelData = {}")
    table.insert(output, "")
    table.insert(output, "LevelData.USE_FALLBACK = true")
    table.insert(output, "")
    table.insert(output, "LevelData.CHECKPOINTS = {")

    for _, cp in ipairs(checkpoints) do
        table.insert(output, string.format("    { position = %s, order = %d },", cp.position, cp.order))
    end

    table.insert(output, "}")
    table.insert(output, "")
    table.insert(output, "LevelData.COINS = {")
    for _, coin in ipairs(coins) do
        table.insert(output, "    " .. coin .. ",")
    end
    table.insert(output, "}")
    table.insert(output, "")
    table.insert(output, "LevelData.FINISH_LINE = " .. (finishLine or "nil"))
    table.insert(output, "")
    table.insert(output, "return LevelData")

    print("=" .. string.rep("=", 70))
    print("GENERATED LEVELDATA — Copy the block below to src/ReplicatedStorage/LevelData.luau")
    print(string.rep("=", 70))
    print(table.concat(output, "\n"))
    print(string.rep("=", 70))
end

task.delay(1, generateLevelData)
